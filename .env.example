# Paylasimli lokal Postgres icin ayarlar.
# Kullanim:  cp .env.example .env   (sonra .env'i istedigin gibi degistir)
#
# .env commit EDILMEZ (.gitignore'da). .env.example commit edilir.
# Bu dosyayi degistirmeden birakirsan bile `docker compose up -d` calisir;
# docker-compose.yml icindeki :- varsayilanlari devreye girer.

# --- Container ---
PG_CONTAINER=dev-postgres

# Host'tan erisilen port (container icinde her zaman 5432).
# Portfolio projesi 5439, eski pathexplorer 5442 kullaniyordu -> 5443 bos.
PG_PORT=5443

# --- Superuser (SADECE ilk `up`ta, volume olusurken uygulanir) ---
# Yan projeler bunu kullanmaz; bunun uzerinden kendi ROLE + DATABASE'lerini acar.
POSTGRES_DB=pathexplorer
POSTGRES_USER=pathexplorer
POSTGRES_PASSWORD=pathexplorer
